# ===== Cloudflare Workers deploy note =====
# - NEXT_PUBLIC_* vars: inlined into the client bundle at build time (from .env.local).
#   They are NOT used at runtime on the Worker.
# - Server-only vars (SUPABASE_SERVICE_ROLE_KEY, R2_*, ADMIN_PASSWORD,
#   ADMIN_COOKIE_SECRET): set these as Worker secrets (`pnpm wrangler secret put
#   <NAME>`) or in `.dev.vars` for local preview. Never commit them.

# ===== Supabase =====
# Project URL & anon key from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-side key for writes via API (Project Settings → API → service_role).
# Hanya dipakai server-side — JANGAN pernah bocor ke browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ===== Admin login (password-only) =====
# Password untuk masuk ke /admin. Fallback default: "".
ADMIN_PASSWORD=
# (Opsional) secret tambahan untuk mengikat cookie sesi admin.
ADMIN_COOKIE_SECRET=

# ===== Cloudflare R2 (S3-compatible storage) =====
# Account ID from Cloudflare dashboard (right side of overview page)
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
# Create API token: R2 → Manage R2 API Tokens (object read/write on your bucket)
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# Bucket name
R2_BUCKET_NAME=portfolio
# Public base URL for uploaded files. Use a custom domain (recommended) or the
# public r2.dev URL (rate-limited), e.g. https://cdn.yourdomain.com or https://pub-xxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.yourdomain.com
