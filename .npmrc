# npm (bukan pnpm) — proyek ini memakai package-lock.json sebagai satu-satunya
# lockfile. Lihat README → Scripts.

# Beberapa paket butuh postinstall untuk mengunduh binary-nya:
#   esbuild  → dipakai tsx (test runner)
#   workerd  → dipakai wrangler (deploy Cloudflare)
#   sharp    → dipakai next/image (proyek ini memakai `unoptimized`)
# Tanpa ini, `npm ci` bisa menghasilkan instalasi tanpa binary.
ignore-scripts=false
